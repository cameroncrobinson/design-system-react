{
  "name": "@design-system/react",
  "version": "0.1.0",
  "description": "React components for the Design System",
  "type": "module",
  "files": ["dist"],
  "sideEffects": ["**/*.css"],
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "build": "tsc && node scripts/build-styles.mjs",
    "build:styles": "node scripts/build-styles.mjs",
    "storybook": "npm run build:styles && storybook dev -p 6006 --no-open --disable-telemetry",
    "storybook:build": "npm run build:styles && storybook build --disable-telemetry",
    "typecheck:storybook": "tsc -p tsconfig.storybook.json",
    "dev": "vite --host 127.0.0.1",
    "demo:build": "vite build",
    "test": "vitest run"
  },
  "peerDependencies": { "react": ">=18 <20", "react-dom": ">=18 <20" },
  "devDependencies": {
    "storybook": "9.1.16",
    "@storybook/react-vite": "9.1.16",
    "@storybook/addon-docs": "9.1.16",
    "@storybook/addon-a11y": "9.1.16",
    "@types/react": "^19.0.0", "@types/react-dom": "^19.0.0",
    "react": "^19.0.0", "react-dom": "^19.0.0", "typescript": "^5.7.0",
    "vite": "^6.0.0", "vitest": "^3.0.0", "jsdom": "^26.0.0",
    "@testing-library/react": "^16.0.0", "sass": "^1.83.0",
    "breakpoint-sass": "^2.7.1", "normalize.css": "^8.0.1"
  },
  "license": "ISC"
}
